{
    "logger": {
        "_target_": "lightning.pytorch.loggers.MLFlowLogger",
        "experiment_name": "Nuclei Foundational Model",
        "run_name": "${metadata.run_name}",
        "tags": {
            "mlflow.note.content": "${metadata.description}"
        }
    },
    "project_path": "/mnt/projects/nuclei_foundation_model",
    "metadata": {
        "experiment_name": "Nuclei Foundation Model",
        "run_name": "Nuclei Segmentation: ${data.name}",
        "description": "",
