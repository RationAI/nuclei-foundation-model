            "mpp": "${mpp}",
            "tile_extent": "${tile_extent}",
            "overlap": "${overlap}",
            "batch_size": "${batch_size}"
        }
    },
    "data": {
        "name": "breast TNBC",
        "slides": "/mnt/projects/epithelium_segmentation/breast/TNBC/tif/he",
        "nuclei": "${project_path}/nuclei/breast/TNBC"
    },
    "mpp": 0.25,
    "tile_extent": 2048,
    "overlap": 64,
    "batch_size": 16
}